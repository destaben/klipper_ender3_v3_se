# ---------------------------------------------------------------------------
# Stage 1: Source – fetch pinned sources. Only this stage is invalidated when a
# commit pin changes; later stages are keyed on the files they COPY from here.
# ---------------------------------------------------------------------------
FROM debian:bookworm-slim AS src

# hadolint ignore=DL3008
RUN apt-get update && \
    apt-get install -y --no-install-recommends git ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /src

# Clone Klipper from 0xD34D/klipper_ender3_v3_se, pinned to a fixed commit
# (upstream Klipper as of 2026-08-13 plus the fork's prtouch support). Keep
# this in sync with sim/Dockerfile-sim and build_firmware.sh.
ARG GITHUB_FORK_URL=https://github.com/0xD34D/klipper_ender3_v3_se.git
ARG KLIPPER_COMMIT=7e61c1ccda2f2e8f6bd518997f3833319da03a20
RUN git clone "$GITHUB_FORK_URL" klipper && \
    git -C klipper checkout "$KLIPPER_COMMIT" && \
    rm -rf klipper/.git

# Clone Shake&Tune, pinned to a fixed commit so rebuilds are reproducible
ARG SHAKETUNE_COMMIT=354ee4be6db218715239f7b9411c2c37fdea23dd
RUN git clone https://github.com/Frix-x/klippain-shaketune.git && \
    git -C klippain-shaketune checkout "$SHAKETUNE_COMMIT" && \
    rm -rf klippain-shaketune/.git

# ---------------------------------------------------------------------------
# Stage 2: Build – virtualenv first (keyed on the requirements files only), then
# the sources and the C helper.
# Debian bookworm (Python 3.11) is the base because piwheels publishes prebuilt
# linux/arm/v7 wheels for cp311 but not for Ubuntu 22.04's cp310; without them
# pip compiles numpy/matplotlib/... from source under QEMU (~90 min).
# ---------------------------------------------------------------------------
FROM debian:bookworm-slim AS builder

ENV DEBIAN_FRONTEND=noninteractive

# hadolint ignore=DL3008
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      python3 python3-dev python3-venv \
      build-essential libffi-dev libssl-dev \
      zlib1g-dev libjpeg-dev libfreetype6-dev \
      libatlas-base-dev libopenblas-dev && \
    rm -rf /var/lib/apt/lists/*

RUN useradd -ms /bin/bash klipper
WORKDIR /home/klipper
USER klipper

# Only the requirements files are copied, so this layer is rebuilt when the
# dependencies change, not on every Klipper or Shake&Tune commit bump.
COPY --from=src --chown=klipper:klipper /src/klipper/scripts/klippy-requirements.txt /tmp/req/klippy-requirements.txt
COPY --from=src --chown=klipper:klipper /src/klippain-shaketune/requirements.txt /tmp/req/shaketune-requirements.txt

# On linux/arm/v7 use piwheels for prebuilt wheels. The index is not added on
# other architectures, where PyPI already has wheels.
ARG TARGETVARIANT
RUN python3 -m venv /home/klipper/klippy-env && \
    if [ "$TARGETVARIANT" = "v7" ]; then export PIP_EXTRA_INDEX_URL=https://www.piwheels.org/simple; fi && \
    /home/klipper/klippy-env/bin/pip install --no-cache-dir \
      -r /tmp/req/klippy-requirements.txt \
      -r /tmp/req/shaketune-requirements.txt

COPY --from=src --chown=klipper:klipper /src/klipper /home/klipper/klipper
# Shake&Tune goes into klippy extras
COPY --from=src --chown=klipper:klipper /src/klippain-shaketune/shaketune /home/klipper/klipper/klippy/extras/shaketune

# Prebuild Klipper's C helper (chelper/c_helper.so) here, where gcc is available.
# Klippy otherwise compiles it on first start, and the runtime stage below has no
# gcc (kept out to keep the image small), so Klippy crash-loops with
# "Unable to build C code module". COPY below preserves file mtimes, so Klippy
# sees the .so as up to date and does not try to rebuild it.
RUN /home/klipper/klippy-env/bin/python -c \
    "import sys; sys.path.insert(0, '/home/klipper/klipper/klippy'); import chelper; chelper.get_ffi()" && \
    test -f /home/klipper/klipper/klippy/chelper/c_helper.so

# ---------------------------------------------------------------------------
# Stage 3: Runtime – copy only what is needed
# ---------------------------------------------------------------------------
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

# hadolint ignore=DL3008
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      python3 python3-venv \
      libatlas3-base libopenblas0 \
      libjpeg62-turbo libfreetype6 zlib1g \
      libtiff6 libopenjp2-7 libwebp7 libwebpdemux2 libwebpmux3 liblcms2-2 libxcb1 \
      libffi8 libssl3 \
      ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN useradd -ms /bin/bash klipper && \
    adduser klipper dialout && \
    mkdir -p /opt/printer_data/config && \
    chown klipper:klipper /opt/printer_data/config

VOLUME /opt/printer_data/config
WORKDIR /home/klipper

# Copy Klipper source (incl. Shake&Tune extras) and virtualenv from builder
COPY --from=builder --chown=klipper:klipper /home/klipper/klipper /home/klipper/klipper
COPY --from=builder --chown=klipper:klipper /home/klipper/klippy-env /home/klipper/klippy-env

RUN mkdir -p /home/klipper/printer_data && chown klipper:klipper /home/klipper/printer_data

USER klipper

CMD ["/home/klipper/klippy-env/bin/python", "/home/klipper/klipper/klippy/klippy.py", "/opt/printer_data/config/printer.cfg", "-a", "/opt/printer_data/config/klippy_uds"]
