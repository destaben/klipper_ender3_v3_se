# ---------------------------------------------------------------------------
# Stage 1: Build – clone repos, install dependencies, build virtualenv
# ---------------------------------------------------------------------------
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

# hadolint ignore=DL3008
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      sudo git curl ca-certificates \
      python3 python3-dev python3-venv \
      virtualenv \
      build-essential \
      libffi-dev libssl-dev \
      zlib1g-dev libjpeg-dev libfreetype6-dev \
      libatlas-base-dev libopenblas-dev && \
    rm -rf /var/lib/apt/lists/*

RUN useradd -ms /bin/bash klipper && \
    echo 'klipper ALL=(ALL:ALL) NOPASSWD: ALL' > /etc/sudoers.d/klipper && \
    chmod 0440 /etc/sudoers.d/klipper && \
    ln -s /bin/true /bin/systemctl

WORKDIR /home/klipper

# Clone Klipper (pinned to known-good commit)
ARG GITHUB_FORK_URL=https://github.com/jpcurti/ender3-v3-se-klipper-with-display.git
ARG KLIPPER_COMMIT=cecc1bba1d8469253600f0d6c383549a8ac9b0aa
RUN git clone "$GITHUB_FORK_URL" /home/klipper/klipper && \
    git -C /home/klipper/klipper checkout "$KLIPPER_COMMIT" && \
    rm -rf /home/klipper/klipper/.git

# Clone Shake&Tune
RUN git clone --depth 1 https://github.com/Frix-x/klippain-shaketune.git && \
    rm -rf /home/klipper/klippain-shaketune/.git

RUN chown -R klipper:klipper /home/klipper

# Install Klipper dependencies (creates klippy-env virtualenv)
USER klipper
RUN /home/klipper/klipper/scripts/install-ubuntu-22.04.sh

# Install Shake&Tune into klippy extras and its pip dependencies
RUN cp -r klippain-shaketune/shaketune /home/klipper/klipper/klippy/extras/ && \
    /home/klipper/klippy-env/bin/pip install --no-cache-dir -r klippain-shaketune/requirements.txt

# ---------------------------------------------------------------------------
# Stage 2: Runtime – copy only what is needed
# ---------------------------------------------------------------------------
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# hadolint ignore=DL3008
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      sudo \
      python3 python3-venv \
      libatlas3-base libopenblas0 \
      libjpeg8 libfreetype6 zlib1g \
      libffi8 libssl3 \
      ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN useradd -ms /bin/bash klipper && \
    adduser klipper dialout && \
    echo 'klipper ALL=(ALL:ALL) NOPASSWD: ALL' > /etc/sudoers.d/klipper && \
    chmod 0440 /etc/sudoers.d/klipper && \
    ln -s /bin/true /bin/systemctl && \
    mkdir -p /opt/printer_data/config && \
    chown klipper:klipper /opt/printer_data/config

VOLUME /opt/printer_data/config
WORKDIR /home/klipper

# Copy Klipper source, virtualenv, and Shake&Tune extras from builder
COPY --from=builder --chown=klipper:klipper /home/klipper/klipper /home/klipper/klipper
COPY --from=builder --chown=klipper:klipper /home/klipper/klippy-env /home/klipper/klippy-env

RUN mkdir -p /home/klipper/printer_data && chown klipper:klipper /home/klipper/printer_data

USER klipper

CMD ["/home/klipper/klippy-env/bin/python", "/home/klipper/klipper/klippy/klippy.py", "/opt/printer_data/config/printer.cfg", "-a", "/opt/printer_data/config/klippy_uds"]
