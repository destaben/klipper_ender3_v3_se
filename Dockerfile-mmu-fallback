# Sidecar for the optional virtual Pico MMU (see docs/virtual-mmu.md).
# One image, two services: mmu_link.py keeps /run/klipper/mmu pointing at the
# real Pico or at the virtual one, and run_virtual.sh runs that virtual MCU (the
# Klipper "linux" firmware with the virtual GPIO patch from sim/patches) in its
# own container. Build context is the repo root.

# ---------------------------------------------------------------------------
# Stage 1: build the virtual MCU
# ---------------------------------------------------------------------------
FROM debian:bookworm-slim AS builder

# hadolint ignore=DL3008
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates git patch python3 build-essential && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /opt

# Keep this in sync with Dockerfile-klipper, sim/Dockerfile-sim and build_firmware.sh.
ARG GITHUB_FORK_URL=https://github.com/0xD34D/klipper_ender3_v3_se.git
ARG KLIPPER_COMMIT=7e61c1ccda2f2e8f6bd518997f3833319da03a20
RUN git clone "$GITHUB_FORK_URL" klipper && \
    git -C klipper checkout "$KLIPPER_COMMIT" && \
    rm -rf klipper/.git

# -F0: fail on any hunk that does not apply exactly, instead of fuzzing it in
COPY sim/patches /tmp/sim-patches
RUN patch -F0 -d /opt/klipper -p1 < /tmp/sim-patches/0001-virtual-gpio-and-tmcuart.patch

RUN printf 'CONFIG_MACH_LINUX=y\nCONFIG_LINUX_VIRTUAL_GPIO=y\n' > /opt/klipper/.config && \
    make -C /opt/klipper olddefconfig && \
    make -C /opt/klipper -j"$(nproc)"

# ---------------------------------------------------------------------------
# Stage 2: runtime
# ---------------------------------------------------------------------------
FROM debian:bookworm-slim

# hadolint ignore=DL3008
RUN apt-get update && \
    apt-get install -y --no-install-recommends python3 && \
    rm -rf /var/lib/apt/lists/*

# Same uid as the user in the klipper image, so the pty the virtual MCU creates
# can be opened by Klippy.
RUN useradd -u 1000 -ms /bin/bash klipper && \
    mkdir -p /run/klipper && chown klipper:klipper /run/klipper

COPY --from=builder /opt/klipper/out/klipper.elf /opt/mmu-fallback/klipper.elf
COPY mmu-fallback/mmu_link.py mmu-fallback/run_virtual.sh /opt/mmu-fallback/

USER klipper
CMD ["python3", "-u", "/opt/mmu-fallback/mmu_link.py"]
