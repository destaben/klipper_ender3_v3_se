# Copy to .env to opt in to the virtual Pico MMU fallback (docs/virtual-mmu.md).
# Without a .env, nothing changes: the stack runs as before.

# Starts the mmu-fallback sidecar
COMPOSE_PROFILES=mmu-fallback

# real: link manager only, never a virtual MCU and never a restart (kill switch)
# auto: virtual MCU when the Pico is unplugged, with an automatic restart on change
# sim:  always virtual
PRINTER_MODE=auto

# Where the sidecar writes the links. Use a tmpfs path (cleared on reboot, no
# stale links) and create it first; the tracked ./serial-links is the read-only
# default and must not be overwritten.
#   sudo install -d -o 1000 -g 1000 /run/klipper-mmu
MMU_LINK_DIR=/run/klipper-mmu

# To verify on the printer (defaults shown, seconds)
# MMU_ABSENT_DEBOUNCE=10
# MMU_PRESENT_DEBOUNCE=3
# MMU_RESTART_COOLDOWN=60
# MMU_QUIET_AFTER_RESTART=20
