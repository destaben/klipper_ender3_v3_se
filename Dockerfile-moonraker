# Use the specific Moonraker image as the base
FROM mkuf/moonraker:v0.9.3-3-gccfe32f

USER root

# Install ffmpeg, create required directories, and clean up in a single layer
# hadolint ignore=DL3008
RUN apt-get update && \
    apt-get install -y --no-install-recommends ffmpeg && \
    rm -rf /var/lib/apt/lists/* && \
    mkdir -p /opt/printer_data/logs && \
    chown moonraker:moonraker /opt/printer_data/logs && \
    mkdir -p /home/klipper/klipper/config /home/klipper/klipper/docs

USER moonraker

# Ensure the default entrypoint and CMD are preserved
ENTRYPOINT ["/opt/venv/bin/python", "moonraker/moonraker/moonraker.py"]
CMD ["-d", "/opt/printer_data"]
